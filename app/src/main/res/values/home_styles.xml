<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="TextAppearance.Drink.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/home_ink</item>
        <item name="android:textSize">@dimen/home_body_text</item>
    </style>
    <style name="TextAppearance.Drink.Muted" parent="TextAppearance.Drink.Body">
        <item name="android:textColor">@color/home_muted</item>
    </style>
    <style name="TextAppearance.Drink.Section" parent="TextAppearance.Drink.Body">
        <item name="android:textSize">@dimen/home_section_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Drink.Nav" parent="TextAppearance.Drink.Body">
        <item name="android:textSize">@dimen/home_nav_text</item>
        <item name="android:textColor">@color/home_muted</item>
    </style>
    <style name="Widget.Drink.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">@dimen/radius_12</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">@dimen/home_zero</item>
        <item name="android:insetBottom">@dimen/home_zero</item>
        <item name="android:minHeight">@dimen/home_touch_target</item>
    </style>
    <style name="Widget.Drink.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/home_input_stroke</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_12</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_12</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_12</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_12</item>
        <item name="hintEnabled">false</item>
        <item name="errorEnabled">false</item>
    </style>
    <style name="ShapeAppearance.Drink.Image" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_12</item>
    </style>
</resources>
