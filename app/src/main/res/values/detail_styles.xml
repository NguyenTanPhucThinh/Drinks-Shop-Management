    <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Drink.Pill</item>
    <item name="chipBackgroundColor">@color/detail_choice_background</item>
    <item name="android:textColor">@color/detail_choice_text</item>
    <item name="chipStrokeColor">@color/home_border</item>
    <item name="chipStrokeWidth">@dimen/divider_height</item>
    <item name="checkedIconVisible">false</item>
    <item name="chipMinHeight">@dimen/detail_chip_height</item>
    <item name="ensureMinTouchTargetSize">true</item>
    <item name="chipMinTouchTargetSize">@dimen/home_touch_target</item>
    <item name="android:textSize">@dimen/home_body_text</item>
    <item name="chipStartPadding">@dimen/spacing_8</item>
    <item name="chipEndPadding">@dimen/spacing_8</item>
    <item name="textStartPadding">@dimen/spacing_4</item>
    <item name="textEndPadding">@dimen/spacing_4</item>
