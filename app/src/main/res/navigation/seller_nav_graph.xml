<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/seller_nav_graph"
    app:startDestination="@id/sellerHomeFragment">
    <fragment
        android:id="@+id/sellerHomeFragment"
        android:name="com.uitdrinkapp.app.ui.seller.home.SellerHomeFragment"
        android:label="@string/seller_title_home" />
    <fragment
        android:id="@+id/sellerNotificationFragment"
        android:name="com.uitdrinkapp.app.ui.seller.notification.SellerNotificationFragment"
        android:label="@string/seller_title_notification" />
    <fragment
        android:id="@+id/sellerOrdersFragment"
        android:name="com.uitdrinkapp.app.ui.seller.orders.OrderManagementFragment"
        android:label="@string/seller_title_orders" />
    <fragment
        android:id="@+id/sellerOrderDetailFragment"
        android:name="com.uitdrinkapp.app.ui.seller.orders.SellerOrderDetailFragment"
        android:label="@string/seller_title_orders">
        <argument
            android:name="order_id"
            app:argType="string"
            android:defaultValue="" />
    </fragment>
    <fragment
        android:id="@+id/sellerProductFragment"
        android:name="com.uitdrinkapp.app.ui.seller.product.ProductManagementFragment"
        android:label="@string/seller_title_product" />
    <fragment
        android:id="@+id/sellerEditProductFragment"
        android:name="com.uitdrinkapp.app.ui.seller.product.SellerProductFormFragment"
        android:label="@string/seller_title_product">
        <argument
            android:name="product_id"
            app:argType="string"
            android:defaultValue="" />
    </fragment>
    <fragment
        android:id="@+id/sellerOtherFeaturesFragment"
        android:name="com.uitdrinkapp.app.ui.seller.otherfeatures.OtherFeaturesFragment"
        android:label="@string/seller_title_other_features" />
    <fragment
        android:id="@+id/sellerHistoryFragment"
        android:name="com.uitdrinkapp.app.ui.seller.otherfeatures.SellerSalesHistoryFragment"
        android:label="@string/seller_feature_sales_history" />
    <fragment
        android:id="@+id/sellerStatisticFragment"
        android:name="com.uitdrinkapp.app.ui.seller.statistic.StatisticFragment"
        android:label="@string/seller_feature_statistic" />
    <fragment
        android:id="@+id/sellerVouchersFragment"
        android:name="com.uitdrinkapp.app.ui.seller.voucher.SellerVouchersFragment"
        android:label="@string/seller_feature_vouchers" />
    <fragment
        android:id="@+id/sellerVoucherFormFragment"
        android:name="com.uitdrinkapp.app.ui.seller.voucher.SellerVoucherFormFragment"
        android:label="@string/seller_voucher_new_title">
        <argument
            android:name="voucher_id"
            app:argType="string"
            android:defaultValue="" />
    </fragment>
    <fragment
        android:id="@+id/sellerProfileFragment"
        android:name="com.uitdrinkapp.app.ui.seller.profile.SellerProfileFragment"
        android:label="@string/seller_title_profile" />
    <action
        android:id="@+id/action_global_orderDetail"
        app:destination="@id/sellerOrderDetailFragment" />
</navigation>
