<?xml version='1.0' encoding='utf-8'?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/nav_graph" app:startDestination="@id/homeFragment">
    <fragment android:id="@+id/homeFragment" android:name="com.uitdrinkapp.app.ui.customer.home.HomeFragment" android:label="@string/home_tab_home">
        <action android:id="@+id/action_home_to_join" app:destination="@id/joinShopFragment"/>
        <action android:id="@+id/action_home_to_shop_info" app:destination="@id/shopInfoFragment"/>
    </fragment>
    <fragment android:id="@+id/shopInfoFragment" android:name="com.uitdrinkapp.app.ui.customer.shopinfo.ShopInfoFragment" android:label="@string/shop_info_title"/>
    <fragment android:id="@+id/joinShopFragment" android:name="com.uitdrinkapp.app.ui.customer.storeentry.JoinShopFragment" android:label="@string/join_title"/>
    <fragment android:id="@+id/vouchersFragment" android:name="com.uitdrinkapp.app.ui.customer.voucher.VouchersFragment" android:label="@string/voucher_title"/>
    <fragment android:id="@+id/productDetailFragment" android:name="com.uitdrinkapp.app.ui.customer.product.ProductDetailFragment" android:label="@string/detail_title">
        <argument android:name="product_id" app:argType="string"/>
    </fragment>
    <fragment android:id="@+id/profileFragment"
        android:name="com.uitdrinkapp.app.ui.customer.profile.ProfileFragment"
        android:label="@string/home_tab_profile"/>
    <fragment android:id="@+id/notificationFragment"
        android:name="com.uitdrinkapp.app.ui.customer.notification.NotificationFragment"
        android:label="@string/vy_notif_title"/>
    <fragment android:id="@+id/loginFragment"
        android:name="com.uitdrinkapp.app.ui.auth.LoginFragment"
        android:label="@string/vy_login_title"/>

    <fragment android:id="@+id/registerFragment"
        android:name="com.uitdrinkapp.app.ui.auth.RegisterFragment"
        android:label="@string/vy_register_title"/>
    <include app:graph="@navigation/nav_graph_thien" />
</navigation>