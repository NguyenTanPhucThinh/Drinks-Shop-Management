<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/seller_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_8">
        <ImageButton
            android:id="@+id/btn_seller_history_back"
            android:layout_width="@dimen/home_touch_target"
            android:layout_height="@dimen/home_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/seller_history_back"
            android:padding="@dimen/spacing_12"
            android:src="@drawable/ic_back"
            app:tint="@color/seller_text_primary" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_4"
            android:layout_weight="1"
            android:text="@string/seller_feature_sales_history"
            android:textAppearance="@style/TextAppearance.Seller.ScreenTitle" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_seller_history_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_4"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/spacing_12"
        android:autofillHints=""
        android:background="@drawable/bg_seller_history_search"
        android:drawableStart="@drawable/ic_seller_history_search"
        android:drawablePadding="@dimen/spacing_8"
        android:hint="@string/seller_history_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/spacing_12"
        android:paddingEnd="@dimen/spacing_12"
        android:singleLine="true"
        android:textColor="@color/seller_text_primary"
        android:textColorHint="@color/thien_seller_orders_muted"
        android:textSize="@dimen/text_14" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_12">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seller_history_all"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:textSize="@dimen/text_12"
                app:cornerRadius="@dimen/radius_pill"
                app:strokeWidth="1dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seller_history_completed"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/spacing_8"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:textSize="@dimen/text_12"
                app:cornerRadius="@dimen/radius_pill"
                app:strokeWidth="1dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seller_history_cancelled"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/spacing_8"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:textSize="@dimen/text_12"
                app:cornerRadius="@dimen/radius_pill"
                app:strokeWidth="1dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seller_history_rejected"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/spacing_8"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:textSize="@dimen/text_12"
                app:cornerRadius="@dimen/radius_pill"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_seller_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_16" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_24">
            <TextView
                android:id="@+id/tv_seller_history_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/seller_history_empty"
                android:textAppearance="@style/TextAppearance.Drink.Muted"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seller_history_clear_search"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/seller_history_clear_search"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
