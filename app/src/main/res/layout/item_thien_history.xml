<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:layout_marginBottom="9dp"
  android:padding="10dp" android:background="@drawable/bg_thien_card">
  <LinearLayout android:id="@+id/thien_history_row" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:minHeight="52dp"
      android:orientation="horizontal" android:gravity="center_vertical" android:clickable="true" android:focusable="true">
    <ImageView android:layout_width="44dp" android:layout_height="44dp"
      android:src="@drawable/ic_thien_cup_asset" android:background="@drawable/bg_thien_mint"
      android:padding="10dp" android:contentDescription="@string/thien_product_illustration"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
      android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="9dp">
      <TextView android:id="@+id/tv_thien_history_id" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
        android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end"/>
      <TextView android:id="@+id/tv_thien_history_products" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp"
        android:textColor="@color/text_secondary" android:maxLines="1" android:ellipsize="end"/>
      <TextView android:id="@+id/tv_thien_history_time" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/text_secondary"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:orientation="vertical" android:gravity="end">
      <TextView android:id="@+id/tv_thien_history_total" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
        android:textColor="@color/primary" android:layout_gravity="end"/>
      <TextView android:id="@+id/tv_thien_history_status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold"
        android:textColor="@color/primary" android:paddingLeft="7dp" android:paddingRight="7dp"
        android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginTop="3dp"
        android:background="@drawable/bg_thien_status_success" android:layout_gravity="end"/>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="end" android:orientation="horizontal" android:layout_marginTop="5dp">
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_thien_history_details"
      android:layout_width="wrap_content" android:layout_height="30dp" android:minWidth="0dp" android:minHeight="0dp"
      android:text="@string/thien_figma_072" android:textSize="11sp" android:textAllCaps="false"
      android:textColor="@color/primary" app:backgroundTint="@color/thien_white"
      android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="8dp"
      app:strokeColor="@color/primary" app:strokeWidth="1dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_thien_history_review"
      android:layout_width="wrap_content" android:layout_height="30dp" android:minWidth="0dp" android:minHeight="0dp"
      android:text="@string/thien_review_action" android:textSize="11sp" android:textAllCaps="false"
      android:textColor="@color/on_primary" app:backgroundTint="@color/primary"
      android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="8dp"
      android:layout_marginStart="6dp"/>
  </LinearLayout>
</LinearLayout>
