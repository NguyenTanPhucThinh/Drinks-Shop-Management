<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/thien_page">
  <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="@dimen/thien_page_space" android:paddingEnd="@dimen/thien_page_space">
    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="@dimen/text_28" android:text="@string/thien_figma_026" android:id="@+id/btn_thien_review_back" android:textStyle="bold" android:gravity="center"/>
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="@dimen/thien_title_size" android:text="@string/thien_figma_056" android:textStyle="bold" android:layout_weight="1"/>
  </LinearLayout>
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/thien_page_space" android:paddingEnd="@dimen/thien_page_space" android:paddingBottom="@dimen/spacing_16">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="@dimen/thien_body_size" android:text="@string/thien_review_unavailable" android:id="@+id/tv_thien_review_unavailable" android:visibility="gone"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/thien_review_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_thien_card" android:padding="@dimen/thien_card_pad" android:layout_marginBottom="@dimen/thien_card_gap">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="@dimen/thien_thumb_size" android:layout_height="@dimen/thien_thumb_size" android:src="@drawable/ic_thien_drink" android:padding="@dimen/spacing_12" android:background="@drawable/bg_thien_mint" android:contentDescription="@string/thien_product_illustration"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_12">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="@dimen/thien_body_size" android:text="@string/thien_figma_057" android:textStyle="bold" android:id="@+id/tv_thien_review_product"/>
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="@dimen/thien_small_size" android:text="" android:id="@+id/tv_thien_review_order"/>
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="@dimen/thien_body_size" android:text="@string/thien_figma_058" android:textStyle="bold"/>
        <RatingBar android:id="@+id/rating_thien_stars" style="?android:attr/ratingBarStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:numStars="5" android:rating="4" android:stepSize="1" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/spacing_12"/>
        <com.google.android.material.chip.ChipGroup android:id="@+id/thien_review_tag_group" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="false" android:layout_marginTop="@dimen/spacing_8">
          <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/thien_figma_059" android:checkable="true" android:checked="true" android:textColor="@color/primary" app:chipBackgroundColor="@color/thien_white" app:chipCornerRadius="@dimen/thien_pill_radius"/>
          <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/thien_figma_060" android:checkable="true" android:checked="false" android:textColor="@color/primary" app:chipBackgroundColor="@color/thien_white" app:chipCornerRadius="@dimen/thien_pill_radius"/>
          <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/thien_figma_061" android:checkable="true" android:checked="false" android:textColor="@color/primary" app:chipBackgroundColor="@color/thien_white" app:chipCornerRadius="@dimen/thien_pill_radius"/>
          <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/thien_figma_062" android:checkable="true" android:checked="false" android:textColor="@color/primary" app:chipBackgroundColor="@color/thien_white" app:chipCornerRadius="@dimen/thien_pill_radius"/>
          <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/thien_figma_063" android:checkable="true" android:checked="false" android:textColor="@color/primary" app:chipBackgroundColor="@color/thien_white" app:chipCornerRadius="@dimen/thien_pill_radius"/>
        </com.google.android.material.chip.ChipGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="@dimen/thien_small_size" android:text="@string/thien_figma_064" android:layout_marginTop="@dimen/spacing_8"/>
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_thien_review_note" android:layout_width="match_parent" android:layout_height="@dimen/thien_feedback_height" android:gravity="top|start" android:inputType="textMultiLine" android:hint="@string/thien_figma_065" android:padding="@dimen/spacing_12" android:background="@drawable/bg_thien_card" android:textSize="@dimen/thien_body_size"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_thien_review_image" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:text="@string/thien_figma_066" android:textSize="@dimen/thien_body_size" android:textAllCaps="false" android:textColor="@color/primary" app:backgroundTint="@color/thien_white" app:cornerRadius="@dimen/radius_8" android:insetTop="0dp" android:insetBottom="0dp" app:strokeColor="@color/primary" app:strokeWidth="1dp" android:layout_marginTop="@dimen/spacing_12"/>
        <ImageView android:id="@+id/iv_thien_review_image" android:layout_width="match_parent" android:layout_height="@dimen/thien_review_image_height" android:visibility="gone" android:contentDescription="@string/thien_review_selected_image" android:scaleType="centerCrop" android:layout_marginTop="@dimen/spacing_8"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_thien_send_review" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:text="@string/thien_figma_067" android:textSize="@dimen/thien_body_size" android:textAllCaps="false" android:textColor="@color/on_primary" app:backgroundTint="@color/primary" app:cornerRadius="@dimen/radius_8" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="@dimen/spacing_12"/>
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>
