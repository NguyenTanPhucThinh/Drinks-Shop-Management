<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/home_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_8" android:paddingTop="@dimen/spacing_8">
        <ImageView android:id="@+id/btn_notif_back"
            android:layout_width="@dimen/home_touch_target" android:layout_height="@dimen/home_touch_target"
            android:padding="@dimen/spacing_12" android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/vy_back"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/vy_notif_title"
            android:textAppearance="@style/TextAppearance.Drink.Section"/>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout android:id="@+id/tab_notification"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:tabTextColor="@color/home_muted" app:tabSelectedTextColor="@color/home_green"
        app:tabIndicatorColor="@color/home_green"/>

    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/vp_notification"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>