<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/home_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_8" android:paddingTop="@dimen/spacing_8">
        <ImageView android:id="@+id/btn_notif_back"
            android:layout_width="@dimen/home_touch_target" android:layout_height="@dimen/home_touch_target"
            android:padding="@dimen/spacing_12" android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/vy_back"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vy_notif_title"
            android:textAppearance="@style/TextAppearance.Drink.Section"
            android:textColor="@color/home_ink"/>
        <TextView android:id="@+id/tv_notif_read_all"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="@dimen/home_touch_target" android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_8"
            android:background="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true"
            android:text="@string/vy_notif_read_all"
            android:textColor="@color/home_green" android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_notif"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_16"/>
        <TextView android:id="@+id/tv_notif_empty"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:visibility="gone"
            android:text="@string/vy_notif_empty"
            android:textAppearance="@style/TextAppearance.Drink.Muted"/>
    </FrameLayout>
</LinearLayout>
