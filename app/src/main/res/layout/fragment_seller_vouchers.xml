<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_voucher_screen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/seller_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/voucher_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/voucher_screen_horizontal_padding">

            <ImageButton
                android:id="@+id/btn_seller_vouchers_back"
                android:layout_width="@dimen/voucher_back_width"
                android:layout_height="@dimen/voucher_back_height"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/seller_back"
                android:padding="@dimen/voucher_back_padding"
                android:src="@drawable/ic_back"
                app:tint="@color/seller_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/seller_feature_vouchers"
                android:textColor="@color/seller_text_primary"
                android:textSize="@dimen/voucher_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_seller_voucher_add"
                android:layout_width="@dimen/voucher_add_width"
                android:layout_height="@dimen/voucher_add_height"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/voucher_add_content_description"
                android:gravity="center"
                android:text="@string/voucher_add_symbol"
                android:textColor="@color/voucher_primary"
                android:textSize="@dimen/voucher_add_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/voucher_filter_row_height"
            android:layout_marginTop="@dimen/voucher_filter_top_margin"
            android:layout_marginBottom="@dimen/voucher_filter_bottom_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/voucher_screen_horizontal_padding">

            <TextView
                android:id="@+id/chip_voucher_running"
                style="@style/Widget.Voucher.FilterChip"
                android:text="@string/seller_voucher_running" />

            <TextView
                android:id="@+id/chip_voucher_expired"
                style="@style/Widget.Voucher.FilterChip"
                android:layout_marginStart="@dimen/voucher_filter_gap"
                android:text="@string/seller_voucher_expired" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:paddingHorizontal="@dimen/voucher_screen_horizontal_padding"
            android:paddingBottom="@dimen/voucher_list_bottom_padding">

            <LinearLayout
                android:id="@+id/ll_seller_voucher_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_voucher_footer"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/voucher_footer_horizontal_padding"
        android:paddingTop="@dimen/voucher_footer_padding_top"
        android:paddingBottom="@dimen/voucher_footer_padding_bottom">

        <TextView
            android:id="@+id/btn_seller_voucher_create"
            android:layout_width="match_parent"
            android:layout_height="@dimen/voucher_create_button_height"
            android:background="@drawable/bg_voucher_create_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/seller_voucher_create"
            android:textColor="@color/white"
            android:textSize="@dimen/voucher_action_text_size"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
