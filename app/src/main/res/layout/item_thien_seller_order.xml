<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    app:cardBackgroundColor="@color/thien_seller_orders_card"
    app:cardCornerRadius="@dimen/radius_12"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/thien_seller_orders_border"
    app:strokeWidth="@dimen/divider_height">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_12">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_thien_seller_order_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Drink.Section"
                    android:textColor="@color/thien_seller_orders_text" />
                <TextView
                    android:id="@+id/tv_thien_seller_order_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/thien_seller_orders_muted" />
            </LinearLayout>
            <TextView
                android:id="@+id/tv_thien_seller_order_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_thien_seller_order_badge"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_4"
                android:paddingBottom="@dimen/spacing_4"
                android:textSize="@dimen/text_12" />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_thien_seller_order_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:textColor="@color/thien_seller_orders_muted"
            android:textSize="@dimen/text_12" />
        <TextView
            android:id="@+id/tv_thien_seller_order_products"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:textColor="@color/thien_seller_orders_text"
            android:textSize="@dimen/text_14"
            android:maxLines="3"
            android:ellipsize="end" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/thien_seller_orders_total"
                android:textStyle="bold"
                android:textColor="@color/thien_seller_orders_text"
                android:textSize="@dimen/text_14" />
            <TextView
                android:id="@+id/tv_thien_seller_order_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/thien_seller_orders_accent"
                android:textSize="@dimen/text_16" />
        </LinearLayout>
        <TextView
            android:id="@+id/btn_thien_seller_order_quick_view"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/thien_seller_orders_quick_height"
            android:gravity="center_vertical"
            android:text="@string/thien_seller_orders_quick"
            android:textSize="@dimen/text_12"
            android:textColor="@color/thien_seller_orders_accent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
        <LinearLayout
            android:id="@+id/ll_thien_seller_order_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_thien_seller_order_secondary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/thien_seller_orders_reject"
                android:textAllCaps="false"
                android:textColor="@color/thien_seller_orders_danger"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/thien_seller_orders_card"
                app:strokeColor="@color/thien_seller_orders_danger"
                app:strokeWidth="@dimen/divider_height"
                app:cornerRadius="@dimen/radius_8" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_thien_seller_order_primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_8"
                android:text="@string/thien_seller_orders_accept"
                android:textAllCaps="false"
                android:textColor="@color/thien_seller_orders_on_accent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/thien_seller_orders_accent"
                app:cornerRadius="@dimen/radius_8" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
