<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_thien_card" android:padding="0dp" android:layout_marginBottom="@dimen/spacing_8">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/thien_card_pad">
    <ImageView android:layout_width="@dimen/thien_thumb_size" android:layout_height="@dimen/thien_thumb_size" android:background="@drawable/bg_thien_mint" android:src="@drawable/ic_thien_drink" android:padding="@dimen/spacing_12" android:contentDescription="@string/thien_product_illustration"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_8">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/primary" android:textSize="@dimen/thien_body_size" android:id="@+id/tv_thien_cart_item_name" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="@dimen/thien_small_size" android:id="@+id/tv_thien_cart_item_options" android:maxLines="2"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="@dimen/thien_small_size" android:id="@+id/tv_thien_cart_item_topping" android:maxLines="1"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="@dimen/thien_small_size" android:id="@+id/tv_thien_cart_item_price" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="@dimen/spacing_8">
      <com.google.android.material.button.MaterialButton android:id="@+id/btn_thien_cart_minus" android:layout_width="32dp" android:layout_height="32dp" android:text="@string/thien_figma_068" android:textSize="@dimen/thien_body_size" android:textAllCaps="false" android:textColor="@color/on_primary" app:backgroundTint="@color/primary" app:cornerRadius="@dimen/thien_pill_radius" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp"/>
      <TextView android:layout_width="25dp" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="@dimen/thien_body_size" android:text="@string/thien_figma_069" android:id="@+id/tv_thien_cart_item_quantity" android:textStyle="bold" android:gravity="center"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btn_thien_cart_plus" android:layout_width="32dp" android:layout_height="32dp" android:text="@string/thien_figma_070" android:textSize="@dimen/thien_body_size" android:textAllCaps="false" android:textColor="@color/on_primary" app:backgroundTint="@color/primary" app:cornerRadius="@dimen/thien_pill_radius" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp"/>
      <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:textColor="@color/error" android:textSize="@dimen/text_20" android:text="@string/thien_figma_071" android:id="@+id/btn_thien_cart_remove" android:textStyle="bold" android:gravity="center" android:contentDescription="@string/thien_remove_item"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
