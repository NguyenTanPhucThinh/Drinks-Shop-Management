<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:layout_marginBottom="8dp" android:minHeight="70dp"
    android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="7dp" android:paddingBottom="7dp"
    android:background="@drawable/bg_thien_card">
    <ImageView android:layout_width="42dp" android:layout_height="42dp"
        android:src="@drawable/ic_thien_cup_asset" android:background="@drawable/bg_thien_mint"
        android:padding="10dp" android:contentDescription="@string/thien_product_illustration"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
        <TextView android:id="@+id/tv_thien_cart_item_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/primary"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tv_thien_cart_item_options" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/text_secondary"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tv_thien_cart_item_topping" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/text_secondary"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tv_thien_cart_item_price" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/text_primary"
            android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="4dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_thien_cart_minus"
            android:layout_width="30dp" android:layout_height="30dp" android:minWidth="0dp" android:minHeight="0dp"
            android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
            android:text="@string/thien_figma_068" android:textSize="15sp" android:textAllCaps="false"
            android:textColor="@color/on_primary" app:backgroundTint="@color/primary"
            app:cornerRadius="15dp" android:contentDescription="@string/thien_decrease_quantity"/>
        <TextView android:id="@+id/tv_thien_cart_item_quantity" android:layout_width="24dp"
            android:layout_height="wrap_content" android:gravity="center" android:textStyle="bold"
            android:textSize="12sp" android:textColor="@color/text_primary"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_thien_cart_plus"
            android:layout_width="30dp" android:layout_height="30dp" android:minWidth="0dp" android:minHeight="0dp"
            android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
            android:text="@string/thien_figma_070" android:textSize="15sp" android:textAllCaps="false"
            android:textColor="@color/on_primary" app:backgroundTint="@color/primary"
            app:cornerRadius="15dp" android:contentDescription="@string/thien_increase_quantity"/>
        <TextView android:id="@+id/btn_thien_cart_remove" android:layout_width="0dp"
            android:layout_height="0dp" android:visibility="gone" android:contentDescription="@string/thien_remove_item"/>
    </LinearLayout>
</LinearLayout>
