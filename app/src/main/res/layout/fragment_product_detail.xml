<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="@dimen/spacing_8" android:baselineAligned="false">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btn_detail_back" android:layout_width="@dimen/home_touch_target" android:layout_height="@dimen/home_touch_target" android:src="@drawable/ic_back" android:padding="@dimen/spacing_12" android:contentDescription="@string/join_back" android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/detail_title" android:textAppearance="@style/TextAppearance.Drink.Section" android:textSize="@dimen/home_header_text"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/scroll_detail" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding" android:paddingBottom="@dimen/spacing_16">
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/iv_detail_image" android:layout_width="match_parent" android:layout_height="@dimen/detail_image_height" android:background="@color/home_mint" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Drink.Image"/>
            <TextView android:id="@+id/tv_detail_category" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_8" android:textAppearance="@style/TextAppearance.Drink.Muted"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <TextView android:id="@+id/tv_detail_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@style/TextAppearance.Drink.Section" android:textSize="@dimen/home_header_text"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_favorite" style="@style/Widget.Material3.Button.IconButton" android:layout_width="@dimen/home_touch_target" android:layout_height="@dimen/home_touch_target" app:icon="@drawable/ic_heart" app:iconTint="@color/home_muted" android:contentDescription="@string/detail_favorite_add"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_quantity_minus" style="@style/Widget.Material3.Button.IconButton.Filled" android:layout_width="@dimen/home_touch_target" android:layout_height="@dimen/home_touch_target" app:icon="@drawable/ic_minus" app:backgroundTint="@color/primary" app:iconTint="@color/on_primary" android:contentDescription="@string/detail_decrease"/>
                <TextView android:id="@+id/tv_quantity" android:layout_width="@dimen/detail_quantity_width" android:layout_height="wrap_content" android:gravity="center" android:textAppearance="@style/TextAppearance.Drink.Body" android:textStyle="bold"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_quantity_plus" style="@style/Widget.Material3.Button.IconButton.Filled" android:layout_width="@dimen/home_touch_target" android:layout_height="@dimen/home_touch_target" app:icon="@drawable/ic_plus" app:backgroundTint="@color/primary" app:iconTint="@color/on_primary" android:contentDescription="@string/detail_increase"/>
            </LinearLayout>
            <TextView android:id="@+id/tv_detail_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Drink.Muted"/>
            <TextView android:id="@+id/btn_description_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="@dimen/home_touch_target" android:minWidth="@dimen/home_touch_target" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:text="@string/detail_show_more" android:textColor="@color/home_green" android:textSize="@dimen/home_body_text" android:visibility="gone"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/detail_available" android:textAppearance="@style/TextAppearance.Drink.Body" android:textStyle="bold"/>
            <com.google.android.material.chip.ChipGroup android:id="@+id/cg_temperature" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="@dimen/spacing_4" app:chipSpacingVertical="@dimen/home_zero">
                <com.google.android.material.chip.Chip android:id="@+id/chip_iced" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_iced"/>
                <com.google.android.material.chip.Chip android:id="@+id/chip_hot" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_hot"/>
            </com.google.android.material.chip.ChipGroup>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/detail_size" android:textAppearance="@style/TextAppearance.Drink.Body" android:textStyle="bold"/>
            <com.google.android.material.chip.ChipGroup android:id="@+id/cg_size" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="@dimen/spacing_4" app:chipSpacingVertical="@dimen/home_zero">
                <com.google.android.material.chip.Chip android:id="@+id/chip_size_s" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_size_s"/>
                <com.google.android.material.chip.Chip android:id="@+id/chip_size_m" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_size_m"/>
                <com.google.android.material.chip.Chip android:id="@+id/chip_size_l" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_size_l"/>
            </com.google.android.material.chip.ChipGroup>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/detail_sugar" android:textAppearance="@style/TextAppearance.Drink.Body" android:textStyle="bold"/>
            <com.google.android.material.chip.ChipGroup android:id="@+id/cg_sugar" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="@dimen/spacing_4" app:chipSpacingVertical="@dimen/home_zero">
                <com.google.android.material.chip.Chip android:id="@+id/chip_sugar_0" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_sugar_0"/>
                <com.google.android.material.chip.Chip android:id="@+id/chip_sugar_30" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_sugar_30"/>
                <com.google.android.material.chip.Chip android:id="@+id/chip_sugar_50" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_sugar_50"/>
                <com.google.android.material.chip.Chip android:id="@+id/chip_sugar_70" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_sugar_70"/>
                <com.google.android.material.chip.Chip android:id="@+id/chip_sugar_100" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_sugar_100"/>
            </com.google.android.material.chip.ChipGroup>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/detail_toppings" android:textAppearance="@style/TextAppearance.Drink.Body" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/detail_max_toppings" android:textAppearance="@style/TextAppearance.Drink.Muted" android:textSize="@dimen/home_small_text"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/ll_toppings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <com.google.android.material.chip.ChipGroup android:id="@+id/cg_fulfillment" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="@dimen/spacing_4" app:chipSpacingVertical="@dimen/home_zero">
                <com.google.android.material.chip.Chip android:id="@+id/chip_counter" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_counter"/>
                <com.google.android.material.chip.Chip android:id="@+id/chip_takeaway" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_takeaway"/>
                <com.google.android.material.chip.Chip android:id="@+id/chip_delivery" style="@style/Widget.Drink.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/detail_delivery"/>
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/ll_detail_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface" android:padding="@dimen/spacing_12" android:orientation="horizontal" android:baselineAligned="false">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_detail_add_cart" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/home_touch_target" android:text="@string/detail_add_cart" android:textColor="@color/home_green" app:strokeColor="@color/home_green" app:cornerRadius="@dimen/radius_12" android:textSize="@dimen/home_body_text"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_detail_buy" style="@style/Widget.Drink.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_8" android:textSize="@dimen/home_body_text"/>
    </LinearLayout>
</LinearLayout>

