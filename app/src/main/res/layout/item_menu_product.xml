<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/spacing_4"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_12"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/home_border"
    app:strokeWidth="@dimen/divider_height">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_8">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_menu_image"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/home_mint"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Drink.Image"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/spacing_12"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_menu_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Drink.Body"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tv_menu_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.Drink.Muted"
                android:textSize="@dimen/home_small_text"/>
            <TextView
                android:id="@+id/tv_menu_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Drink.Body"
                android:textColor="@color/home_green"
                android:textStyle="bold"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_add"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:iconSize="14dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_plus"
            app:iconTint="@color/on_primary"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_pill"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
