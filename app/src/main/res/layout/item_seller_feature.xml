<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_seller_surface_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">
    <ImageView
        android:id="@+id/iv_seller_feature_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_seller_icon_circle"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:scaleType="fitCenter" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_seller_feature_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/seller_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_seller_feature_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/seller_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="›"
        android:textColor="@color/seller_text_secondary"
        android:textSize="24sp" />
</LinearLayout>
