<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/thien_seller_orders_card"
    app:cardCornerRadius="@dimen/radius_12"
    app:cardElevation="0dp"
    app:strokeColor="@color/thien_seller_orders_border"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_12">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_seller_history_order_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/thien_seller_orders_text"
                android:textSize="@dimen/text_16"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_seller_history_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_seller_history_badge"
                android:paddingStart="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_4"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingBottom="@dimen/spacing_4"
                android:textSize="@dimen/text_12" />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_seller_history_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:textColor="@color/thien_seller_orders_muted"
            android:textSize="@dimen/text_12" />
        <TextView
            android:id="@+id/tv_seller_history_customer_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/thien_seller_orders_text"
            android:textSize="@dimen/text_12" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_seller_history_products"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/thien_seller_orders_text"
                android:textSize="@dimen/text_12" />
            <TextView
                android:id="@+id/tv_seller_history_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:textColor="@color/thien_seller_orders_accent"
                android:textSize="@dimen/text_16"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_seller_history_review"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="@dimen/text_12" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seller_history_details"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/spacing_8"
                android:minWidth="88dp"
                android:minHeight="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/seller_history_details"
                android:textAllCaps="false"
                android:textColor="@color/thien_seller_orders_on_accent"
                android:textSize="@dimen/text_14"
                app:backgroundTint="@color/thien_seller_orders_accent"
                app:cornerRadius="@dimen/radius_8" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
