<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/seller_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Shop Header & Status Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_seller_home_shop_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quán Trà Sữa ABC"
                    android:textColor="@color/seller_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Trạng thái mở cửa + công tắc nằm cạnh nhau dưới tên quán -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_thien_warning_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang mở cửa"
                            android:textColor="@color/seller_nav_active"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_shop_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Chuông thông báo nhỏ (thay cho tab thông báo ở thanh điều hướng) -->
            <FrameLayout
                android:id="@+id/btn_seller_home_bell"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/seller_title_notification"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_seller_notification"
                    app:tint="@color/seller_nav_active" />

                <View
                    android:id="@+id/v_seller_home_bell_badge"
                    android:layout_width="@dimen/home_badge_size"
                    android:layout_height="@dimen/home_badge_size"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_home_badge"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 2x2 Dashboard Metric Cards -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="2"
            android:rowCount="2">

            <!-- Card 1: Đơn mới -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_seller_surface_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đơn mới"
                    android:textColor="@color/seller_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_stat_new_orders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="5"
                    android:textColor="@color/seller_nav_active"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 2: Đang pha chế -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_seller_surface_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang pha chế"
                    android:textColor="@color/seller_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_stat_preparing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="3"
                    android:textColor="@color/seller_nav_active"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 3: Doanh thu hôm nay -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_seller_surface_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doanh thu hôm nay"
                    android:textColor="@color/seller_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_stat_revenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="1.250.000đ"
                    android:textColor="@color/seller_nav_active"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 4: Đơn hoàn thành -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="2dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_seller_surface_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đơn hoàn thành"
                    android:textColor="@color/seller_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_stat_completed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="28"
                    android:textColor="@color/seller_nav_active"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </GridLayout>

        <!-- Recent Orders Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đơn mới nhất"
                android:textColor="@color/seller_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_seller_home_see_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="Xem tất cả"
                android:textColor="@color/seller_nav_active"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_seller_home_orders_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/seller_home_orders_empty"
            android:textAppearance="@style/TextAppearance.Drink.Muted"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_seller_home_orders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
